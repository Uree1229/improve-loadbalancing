Subject: [PATCH] sched/fair: handle affinity recovery in a separate tasklet

Keep ordinary SCHED_SOFTIRQ and periodic balancing source unchanged.
Use irq_work only to enqueue a coalesced tasklet on allowed targets;
perform one forced balance pass in normal tasklet softirq context.

---
diff --git a/kernel/sched/Makefile b/kernel/sched/Makefile
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -30,3 +30,5 @@
 obj-$(CONFIG_MEMBARRIER) += membarrier.o
 obj-$(CONFIG_CPU_ISOLATION) += isolation.o
 obj-$(CONFIG_PSI) += psi.o
+
+obj-$(CONFIG_SMP) += affinity.o
diff --git a/kernel/sched/affinity.c b/kernel/sched/affinity.c
new file mode 100644
--- /dev/null
+++ b/kernel/sched/affinity.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Event-only affinity recovery; no hook in ordinary SCHED_SOFTIRQ. */
+#include "sched.h"
+#include <linux/interrupt.h>
+#include <linux/irq_work.h>
+
+#ifdef CONFIG_IRQ_WORK
+struct affinity_balance_work {
+	struct irq_work work;
+	struct tasklet_struct tasklet;
+	int cpu;
+};
+
+static DEFINE_PER_CPU_SHARED_ALIGNED(struct affinity_balance_work,
+				    affinity_balance_work);
+DEFINE_PER_CPU(unsigned long, sched_affinity_hints);
+DEFINE_PER_CPU(unsigned long, sched_affinity_queues);
+DEFINE_PER_CPU(unsigned long, sched_affinity_works);
+DEFINE_PER_CPU(unsigned long, sched_affinity_resets);
+
+static void affinity_balance_tasklet(unsigned long data)
+{
+	struct affinity_balance_work *state = (void *)data;
+	int cpu = smp_processor_id();
+
+	/* CPU-dead tasklets can be taken over by a different CPU. */
+	if (unlikely(state->cpu != cpu || !cpu_active(cpu)))
+		return;
+	sched_affinity_force_balance();
+}
+
+static void affinity_balance_irq(struct irq_work *work)
+{
+	struct affinity_balance_work *state;
+
+	state = container_of(work, struct affinity_balance_work, work);
+	this_cpu_inc(sched_affinity_works);
+	if (likely(cpu_active(smp_processor_id())))
+		tasklet_schedule(&state->tasklet);
+}
+
+void sched_affinity_rebalance(struct rq *source,
+			      const struct cpumask *allowed)
+{
+	int cpu;
+
+	lockdep_assert_held(&source->lock);
+	this_cpu_inc(sched_affinity_hints);
+	rcu_read_lock();
+	for_each_cpu_and(cpu, allowed, cpu_active_mask) {
+		struct rq *target = cpu_rq(cpu);
+		struct affinity_balance_work *state;
+
+		if (cpu == cpu_of(source) ||
+		    !rcu_dereference_sched(target->sd) ||
+		    !cpumask_test_cpu(cpu_of(source), target->rd->span))
+			continue;
+		state = &per_cpu(affinity_balance_work, cpu);
+		if (irq_work_queue_on(&state->work, cpu))
+			this_cpu_inc(sched_affinity_queues);
+	}
+	rcu_read_unlock();
+}
+
+void __init sched_affinity_init(void)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		struct affinity_balance_work *state;
+
+		state = &per_cpu(affinity_balance_work, cpu);
+		state->cpu = cpu;
+		init_irq_work(&state->work, affinity_balance_irq);
+		tasklet_init(&state->tasklet, affinity_balance_tasklet,
+			     (unsigned long)state);
+	}
+}
+#endif
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -1728,6 +1728,9 @@
 	struct rq_flags rf;
 	struct rq *rq;
 	int ret = 0;
+#if defined(CONFIG_SMP) && defined(CONFIG_IRQ_WORK)
+	bool affinity_expanded;
+#endif
 
 	rq = task_rq_lock(p, &rf);
 	update_rq_clock(rq);
@@ -1757,7 +1760,19 @@
 		goto out;
 	}
 
+#if defined(CONFIG_SMP) && defined(CONFIG_IRQ_WORK)
+	/* Equal masks returned above, so this detects a strict superset. */
+	affinity_expanded = !(p->flags & PF_KTHREAD) &&
+		p->sched_class == &fair_sched_class &&
+		task_on_rq_queued(p) && rq->cfs.h_nr_running > 1 &&
+		cpumask_subset(&p->cpus_mask, new_mask);
+#endif
 	do_set_cpus_allowed(p, new_mask);
+
+#if defined(CONFIG_SMP) && defined(CONFIG_IRQ_WORK)
+	if (unlikely(affinity_expanded))
+		sched_affinity_rebalance(rq, new_mask);
+#endif
 
 	if (p->flags & PF_KTHREAD) {
 		/*
diff --git a/kernel/sched/debug.c b/kernel/sched/debug.c
--- a/kernel/sched/debug.c
+++ b/kernel/sched/debug.c
@@ -667,6 +667,17 @@
 #undef P
 #undef PN
 
+#if defined(CONFIG_SMP) && defined(CONFIG_IRQ_WORK)
+	SEQ_printf(m, "  .%-30s: %lu\n", "affinity_hints",
+		   per_cpu(sched_affinity_hints, cpu));
+	SEQ_printf(m, "  .%-30s: %lu\n", "affinity_queues",
+		   per_cpu(sched_affinity_queues, cpu));
+	SEQ_printf(m, "  .%-30s: %lu\n", "affinity_works",
+		   per_cpu(sched_affinity_works, cpu));
+	SEQ_printf(m, "  .%-30s: %lu\n", "affinity_resets",
+		   per_cpu(sched_affinity_resets, cpu));
+#endif
+
 #ifdef CONFIG_SMP
 #define P64(n) SEQ_printf(m, "  .%-30s: %Ld\n", #n, rq->n);
 	P64(avg_idle);
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -10607,9 +10607,128 @@
 #endif /* CONFIG_NUMA_BALANCING */
 #endif /* CONFIG_SCHED_DEBUG */
 
+#if defined(CONFIG_SMP) && defined(CONFIG_IRQ_WORK)
+/* Affinity recovery runs only from the separate tasklet path. */
+void __cold sched_affinity_force_balance(void)
+{
+	struct rq *rq = this_rq();
+	enum cpu_idle_type idle = idle_cpu(rq->cpu) ?
+				      CPU_IDLE : CPU_NOT_IDLE;
+	int continue_balancing = 1;
+	int cpu = rq->cpu;
+	unsigned long interval;
+	struct sched_domain *sd;
+	/* Earliest time when we have to do rebalance again */
+	unsigned long next_balance = jiffies + 60 * HZ;
+	int update_next_balance = 0;
+	int need_serialize, need_decay = 0;
+	u64 max_cost = 0;
+
+	if (unlikely(!cpu_active(cpu) || on_null_domain(rq)))
+		return;
+
+	update_blocked_averages(cpu);
+	rcu_read_lock();
+	for_each_domain(cpu, sd) {
+		/*
+		 * Decay the newidle max times here because this is a regular
+		 * visit to all the domains. Decay ~1% per second.
+		 */
+		if (time_after(jiffies, sd->next_decay_max_lb_cost)) {
+			sd->max_newidle_lb_cost =
+				(sd->max_newidle_lb_cost * 253) / 256;
+			sd->next_decay_max_lb_cost = jiffies + HZ;
+			need_decay = 1;
+		}
+		max_cost += sd->max_newidle_lb_cost;
+
+		if (!(sd->flags & SD_LOAD_BALANCE))
+			continue;
+
+		/*
+		 * Stop the load balance at this level. There is another
+		 * CPU in our sched group which is doing load balancing more
+		 * actively.
+		 */
+		if (!continue_balancing) {
+			if (need_decay)
+				continue;
+			break;
+		}
+
+		interval = get_sd_balance_interval(sd, idle != CPU_IDLE);
+
+		need_serialize = sd->flags & SD_SERIALIZE;
+		if (need_serialize) {
+			if (!spin_trylock(&balancing))
+				goto out;
+		}
+
+		/* An expanded mask invalidates the previous backoff. */
+		sd->balance_interval = sd->min_interval;
+		interval = get_sd_balance_interval(sd, idle != CPU_IDLE);
+#ifdef CONFIG_IRQ_WORK
+		this_cpu_inc(sched_affinity_resets);
+#endif
+		if (load_balance(cpu, rq, sd, idle, &continue_balancing)) {
+			/*
+			 * The LBF_DST_PINNED logic could have changed
+			 * env->dst_cpu, so we can't know our idle
+			 * state even if we migrated tasks. Update it.
+			 */
+			idle = idle_cpu(cpu) ? CPU_IDLE : CPU_NOT_IDLE;
+		}
+		sd->last_balance = jiffies;
+		interval = get_sd_balance_interval(sd, idle != CPU_IDLE);
+		if (need_serialize)
+			spin_unlock(&balancing);
+out:
+		if (time_after(next_balance, sd->last_balance + interval)) {
+			next_balance = sd->last_balance + interval;
+			update_next_balance = 1;
+		}
+	}
+	if (need_decay) {
+		/*
+		 * Ensure the rq-wide value also decays but keep it at a
+		 * reasonable floor to avoid funnies with rq->avg_idle.
+		 */
+		rq->max_idle_balance_cost =
+			max((u64)sysctl_sched_migration_cost, max_cost);
+	}
+	rcu_read_unlock();
+
+	/*
+	 * next_balance will be updated only when there is a need.
+	 * When the cpu is attached to null domain for ex, it will not be
+	 * updated.
+	 */
+	if (likely(update_next_balance)) {
+		rq->next_balance = next_balance;
+
+#ifdef CONFIG_NO_HZ_COMMON
+		/*
+		 * If this CPU has been elected to perform the nohz idle
+		 * balance. Other idle CPUs have already rebalanced with
+		 * nohz_idle_balance() and nohz.next_balance has been
+		 * updated accordingly. This CPU is now running the idle load
+		 * balance for itself and we need to update the
+		 * nohz.next_balance accordingly.
+		 */
+		if ((idle == CPU_IDLE) &&
+		    time_after(nohz.next_balance, rq->next_balance))
+			nohz.next_balance = rq->next_balance;
+#endif
+	}
+}
+#endif
+
 __init void init_sched_fair_class(void)
 {
 #ifdef CONFIG_SMP
+#ifdef CONFIG_IRQ_WORK
+	sched_affinity_init();
+#endif
 	open_softirq(SCHED_SOFTIRQ, run_rebalance_domains);
 
 #ifdef CONFIG_NO_HZ_COMMON
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -1878,6 +1878,17 @@
 extern void init_sched_rt_class(void);
 extern void init_sched_fair_class(void);
 
+#if defined(CONFIG_SMP) && defined(CONFIG_IRQ_WORK)
+void sched_affinity_init(void);
+void sched_affinity_force_balance(void);
+void sched_affinity_rebalance(struct rq *source,
+			      const struct cpumask *allowed);
+DECLARE_PER_CPU(unsigned long, sched_affinity_hints);
+DECLARE_PER_CPU(unsigned long, sched_affinity_queues);
+DECLARE_PER_CPU(unsigned long, sched_affinity_works);
+DECLARE_PER_CPU(unsigned long, sched_affinity_resets);
+#endif
+
 extern void reweight_task(struct task_struct *p, int prio);
 
 extern void resched_curr(struct rq *rq);
