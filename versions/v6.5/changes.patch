+
+static int sched_hot_policy_set(void *data, u64 value)
+{
+	unsigned long flags;
+	int cpu;
+
+	if (value > 3)
+		return -EINVAL;
+	mutex_lock(&sched_hot_control_mutex);
+	/* Stop new marks, then clear every source-rq window under its lock. */
+	WRITE_ONCE(sched_hot_policy, 0);
+	for_each_possible_cpu(cpu) {
+		struct rq *rq = cpu_rq(cpu);
+
+		raw_spin_lock_irqsave(&rq->lock, flags);
+		WRITE_ONCE(per_cpu(sched_hot_expires, cpu), 0);
+		raw_spin_unlock_irqrestore(&rq->lock, flags);
+	}
+	WRITE_ONCE(sched_hot_policy, (unsigned int)value);
+	mutex_unlock(&sched_hot_control_mutex);
+	return 0;
+}
