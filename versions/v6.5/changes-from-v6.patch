+/*
+ * Experimental hot policies, switched only between benchmark trials:
+ * 0: v6, 1: v6.2, 2: v6.4, 3: v6.5 (bounded source-rq window).
+ * All modes retain v6's affinity kick. This is not an upstream-kernel control.
+ */
+static unsigned int sched_hot_policy __read_mostly;
+static DEFINE_PER_CPU(u64, sched_hot_expires);
+static DEFINE_STATIC_KEY_FALSE(sched_hot_diagnostics);
+static DEFINE_MUTEX(sched_hot_control_mutex);
+
+struct sched_hot_counters {
+	unsigned long calls;
+	unsigned long buddy_hot;
+	unsigned long always_hot;
+	unsigned long cost_disabled;
+	unsigned long threshold_checks;
+	unsigned long threshold_reduced;
+	unsigned long original_hot;
+	unsigned long relaxed_hot;
+	unsigned long relaxed_idle;
+	unsigned long relaxed_newidle;
+	unsigned long final_hot;
+	unsigned long window_marks;
+};
+static DEFINE_PER_CPU(struct sched_hot_counters, sched_hot_counters);
+
+#define HOT_COUNT(field) do { \
+	if (static_branch_unlikely(&sched_hot_diagnostics)) \
+		this_cpu_inc(sched_hot_counters.field); \
+} while (0)
+
+#ifdef CONFIG_SCHED_DEBUG
+static int sched_hot_policy_get(void *data, u64 *value)
+{
+	*value = READ_ONCE(sched_hot_policy);
+	return 0;
+}
+
+static int sched_hot_policy_set(void *data, u64 value)
+{
+	unsigned long flags;
+	int cpu;
+
+	if (value > 3)
+		return -EINVAL;
+	mutex_lock(&sched_hot_control_mutex);
+	/* Stop new marks, then clear every source-rq window under its lock. */
+	WRITE_ONCE(sched_hot_policy, 0);
+	for_each_possible_cpu(cpu) {
+		struct rq *rq = cpu_rq(cpu);
+
+		raw_spin_lock_irqsave(&rq->lock, flags);
+		WRITE_ONCE(per_cpu(sched_hot_expires, cpu), 0);
+		raw_spin_unlock_irqrestore(&rq->lock, flags);
+	}
+	WRITE_ONCE(sched_hot_policy, (unsigned int)value);
+	mutex_unlock(&sched_hot_control_mutex);
+	return 0;
+}
+DEFINE_SIMPLE_ATTRIBUTE(sched_hot_policy_fops, sched_hot_policy_get,
+			sched_hot_policy_set, "%llu\n");
+
+static int sched_hot_diagnostics_get(void *data, u64 *value)
+{
+	*value = static_branch_unlikely(&sched_hot_diagnostics);
+	return 0;
+}
+
+static int sched_hot_diagnostics_set(void *data, u64 value)
+{
+	if (value > 1)
+		return -EINVAL;
+	mutex_lock(&sched_hot_control_mutex);
+	if (value)
+		static_branch_enable(&sched_hot_diagnostics);
+	else
+		static_branch_disable(&sched_hot_diagnostics);
+	mutex_unlock(&sched_hot_control_mutex);
+	return 0;
+}
+DEFINE_SIMPLE_ATTRIBUTE(sched_hot_diagnostics_fops, sched_hot_diagnostics_get,
+			sched_hot_diagnostics_set, "%llu\n");
+
+static int sched_hot_stats_show(struct seq_file *m, void *v)
+{
+	int cpu;
+
+	seq_printf(m, "policy %u\ndiagnostics %u\nwindow_ms 16\n",
+		   READ_ONCE(sched_hot_policy),
+		   !!static_branch_unlikely(&sched_hot_diagnostics));
+	for_each_possible_cpu(cpu) {
+		struct sched_hot_counters *c = &per_cpu(sched_hot_counters, cpu);
+
+		seq_printf(m, "cpu %d", cpu);
+#define HOT_PRINT(field) seq_printf(m, " " #field "=%lu", READ_ONCE(c->field))
+		HOT_PRINT(calls);
+		HOT_PRINT(buddy_hot);
+		HOT_PRINT(always_hot);
+		HOT_PRINT(cost_disabled);
+		HOT_PRINT(threshold_checks);
+		HOT_PRINT(threshold_reduced);
+		HOT_PRINT(original_hot);
+		HOT_PRINT(relaxed_hot);
+		HOT_PRINT(relaxed_idle);
+		HOT_PRINT(relaxed_newidle);
+		HOT_PRINT(final_hot);
+		HOT_PRINT(window_marks);
+#undef HOT_PRINT
+		seq_putc(m, '\n');
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(sched_hot_stats);
+
+static int __init sched_hot_debug_init(void)
+{
+	struct dentry *dir = debugfs_create_dir("sched_hot_v65", NULL);
+
+	if (IS_ERR_OR_NULL(dir))
