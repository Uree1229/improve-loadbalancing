 /*
  * Is this task likely cache-hot:
  */
 static int task_hot(struct task_struct *p, struct lb_env *env)
 {
 	s64 delta;
+	s64 migration_cost;
+	unsigned int policy, original_cost;
+	bool relax = false;
 
 	lockdep_assert_held(&env->src_rq->lock);
+	HOT_COUNT(calls);
 
 	if (p->sched_class != &fair_sched_class)
 		return 0;
@@ -7208,17 +7346,65 @@
 	 */
 	if (sched_feat(CACHE_HOT_BUDDY) && env->dst_rq->nr_running &&
 			(&p->se == cfs_rq_of(&p->se)->next ||
-			 &p->se == cfs_rq_of(&p->se)->last))
+			 &p->se == cfs_rq_of(&p->se)->last)) {
+		HOT_COUNT(buddy_hot);
 		return 1;
-
-	if (sysctl_sched_migration_cost == -1)
+	}
+
+	original_cost = READ_ONCE(sysctl_sched_migration_cost);
+	if (original_cost == (unsigned int)-1) {
+		HOT_COUNT(always_hot);
 		return 1;
-	if (sysctl_sched_migration_cost == 0)
+	}
+	if (original_cost == 0) {
+		HOT_COUNT(cost_disabled);
 		return 0;
+	}
 
 	delta = rq_clock_task(env->src_rq) - p->se.exec_start;
 
-	return delta < (s64)sysctl_sched_migration_cost;
+	migration_cost = original_cost;
+	policy = READ_ONCE(sched_hot_policy);
+	if (policy == 1) {
+		relax = env->idle == CPU_NEWLY_IDLE;
+	} else if (policy == 2) {
+		relax = env->affinity_reset && env->idle == CPU_IDLE;
+	} else if (policy == 3 && env->idle != CPU_NOT_IDLE &&
+		   !READ_ONCE(env->dst_rq->nr_running)) {
+		u64 expires = per_cpu(sched_hot_expires, env->src_cpu);
+
+		/* The source-rq lock protects this 64-bit field on all targets. */
+		if (expires) {
+			if (ktime_get_ns() < expires)
+				relax = true;
+			else
+				per_cpu(sched_hot_expires, env->src_cpu) = 0;
+		}
+	}
+	if (relax && env->src_rq->cfs.h_nr_running > 1) {
+		if (env->src_rq->cfs.h_nr_running > 2)
+			migration_cost /= 4;
+		else
+			migration_cost /= 2;
+	}
+	/* Predicate evaluations, not successful migrations. Disabled for timing. */
+	if (static_branch_unlikely(&sched_hot_diagnostics)) {
+		this_cpu_inc(sched_hot_counters.threshold_checks);
+		if (migration_cost != original_cost)
+			this_cpu_inc(sched_hot_counters.threshold_reduced);
+		if (delta < (s64)original_cost)
+			this_cpu_inc(sched_hot_counters.original_hot);
+		if (delta < migration_cost) {
+			this_cpu_inc(sched_hot_counters.final_hot);
+		} else if (delta < (s64)original_cost) {
+			this_cpu_inc(sched_hot_counters.relaxed_hot);
+			if (env->idle == CPU_NEWLY_IDLE)
+				this_cpu_inc(sched_hot_counters.relaxed_newidle);
+			else if (env->idle == CPU_IDLE)
+				this_cpu_inc(sched_hot_counters.relaxed_idle);
+		}
+	}
+	return delta < migration_cost;
 }
 
