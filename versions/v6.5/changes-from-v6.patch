+	debugfs_create_file("policy", 0600, dir, NULL, &sched_hot_policy_fops);
+	debugfs_create_file("diagnostics", 0600, dir, NULL,
+			    &sched_hot_diagnostics_fops);
+	debugfs_create_file("stats", 0400, dir, NULL, &sched_hot_stats_fops);
+	return 0;
+}
+late_initcall(sched_hot_debug_init);
