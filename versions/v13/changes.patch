diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index d2a68ae..197dddb 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -10607,9 +10607,315 @@ void show_numa_stats(struct task_struct *p, struct seq_file *m)
 #endif /* CONFIG_NUMA_BALANCING */
 #endif /* CONFIG_SCHED_DEBUG */
 
+#if defined(CONFIG_SMP) && defined(CONFIG_IRQ_WORK)
+/* Affinity recovery runs only from the separate tasklet path. */
+void __cold sched_affinity_force_balance(void)
+{
+	struct rq *rq = this_rq();
+	enum cpu_idle_type idle = idle_cpu(rq->cpu) ?
+				      CPU_IDLE : CPU_NOT_IDLE;
+	int continue_balancing = 1;
+	int cpu = rq->cpu;
+	unsigned long interval;
+	struct sched_domain *sd;
+	/* Earliest time when we have to do rebalance again */
+	unsigned long next_balance = jiffies + 60 * HZ;
+	int update_next_balance = 0;
+	int need_serialize, need_decay = 0;
+	u64 max_cost = 0;
+
+	if (unlikely(!cpu_active(cpu) || on_null_domain(rq)))
+		return;
+
+	update_blocked_averages(cpu);
+	rcu_read_lock();
+	for_each_domain(cpu, sd) {
+		/*
+		 * Decay the newidle max times here because this is a regular
+		 * visit to all the domains. Decay ~1% per second.
+		 */
+		if (time_after(jiffies, sd->next_decay_max_lb_cost)) {
+			sd->max_newidle_lb_cost =
+				(sd->max_newidle_lb_cost * 253) / 256;
+			sd->next_decay_max_lb_cost = jiffies + HZ;
+			need_decay = 1;
+		}
+		max_cost += sd->max_newidle_lb_cost;
+
+		if (!(sd->flags & SD_LOAD_BALANCE))
+			continue;
+
+		/*
+		 * Stop the load balance at this level. There is another
+		 * CPU in our sched group which is doing load balancing more
+		 * actively.
+		 */
+		if (!continue_balancing) {
+			if (need_decay)
+				continue;
+			break;
+		}
+
+		interval = get_sd_balance_interval(sd, idle != CPU_IDLE);
+
+		need_serialize = sd->flags & SD_SERIALIZE;
+		if (need_serialize) {
+			if (!spin_trylock(&balancing))
+				goto out;
+		}
+
+		/* An expanded mask invalidates the previous backoff. */
+		sd->balance_interval = sd->min_interval;
+		interval = get_sd_balance_interval(sd, idle != CPU_IDLE);
+#ifdef CONFIG_IRQ_WORK
+		this_cpu_inc(sched_affinity_resets);
+#endif
+		if (load_balance(cpu, rq, sd, idle, &continue_balancing)) {
+			/*
+			 * The LBF_DST_PINNED logic could have changed
+			 * env->dst_cpu, so we can't know our idle
+			 * state even if we migrated tasks. Update it.
+			 */
+			idle = idle_cpu(cpu) ? CPU_IDLE : CPU_NOT_IDLE;
+		}
+		sd->last_balance = jiffies;
+		interval = get_sd_balance_interval(sd, idle != CPU_IDLE);
+		if (need_serialize)
+			spin_unlock(&balancing);
+out:
+		if (time_after(next_balance, sd->last_balance + interval)) {
+			next_balance = sd->last_balance + interval;
+			update_next_balance = 1;
+		}
+	}
+	if (need_decay) {
+		/*
+		 * Ensure the rq-wide value also decays but keep it at a
+		 * reasonable floor to avoid funnies with rq->avg_idle.
+		 */
+		rq->max_idle_balance_cost =
+			max((u64)sysctl_sched_migration_cost, max_cost);
+	}
+	rcu_read_unlock();
+
+	/*
+	 * next_balance will be updated only when there is a need.
+	 * When the cpu is attached to null domain for ex, it will not be
+	 * updated.
+	 */
+	if (likely(update_next_balance)) {
+		rq->next_balance = next_balance;
+
+#ifdef CONFIG_NO_HZ_COMMON
+		/*
+		 * If this CPU has been elected to perform the nohz idle
+		 * balance. Other idle CPUs have already rebalanced with
+		 * nohz_idle_balance() and nohz.next_balance has been
+		 * updated accordingly. This CPU is now running the idle load
+		 * balance for itself and we need to update the
+		 * nohz.next_balance accordingly.
+		 */
+		if ((idle == CPU_IDLE) &&
+		    time_after(nohz.next_balance, rq->next_balance))
+			nohz.next_balance = rq->next_balance;
+#endif
+	}
+}
+
+/*
+ * A widened affinity can redistribute queued work before group load averages
+ * identify a busy group. An idle destination may take one eligible task.
+ */
+void __cold sched_affinity_pull_idle(void)
+{
+	struct rq *target = this_rq();
+	struct rq *source = NULL;
+	struct task_struct *p = NULL, *task;
+	struct sched_domain *sd;
+	struct rq_flags rf;
+	unsigned int busiest = 1;
+	unsigned int scanned = 0;
+	int cpu, dst = smp_processor_id();
+
+	if (!cpu_active(dst) || !idle_cpu(dst))
+		return;
+	this_cpu_inc(sched_affinity_pull_attempts);
+	rcu_read_lock();
+	sd = rcu_dereference(target->sd);
+	while (sd && !(sd->flags & SD_LOAD_BALANCE))
+		sd = sd->parent;
+	if (!sd)
+		goto out_rcu;
+
+	/* Stay in the nearest balancing domain; do not force remote work. */
+	for_each_cpu_and(cpu, sched_domain_span(sd), cpu_active_mask) {
+		struct rq *rq = cpu_rq(cpu);
+		unsigned int running;
+
+		if (cpu == dst)
+			continue;
+		running = READ_ONCE(rq->cfs.h_nr_running);
+		if (running > busiest) {
+			busiest = running;
+			source = rq;
+		}
+	}
+	if (!source)
+		goto out_rcu;
+
+	rq_lock_irqsave(source, &rf);
+	if (!cpu_active(cpu_of(source)) || !cpu_active(dst) ||
+	    !idle_cpu(dst) || source->cfs.h_nr_running <= 1)
+		goto out_unlock;
+	update_rq_clock(source);
+	{
+		struct lb_env env = {
+			.sd		= sd,
+			.dst_cpu	= dst,
+			.dst_rq		= target,
+			.src_cpu	= cpu_of(source),
+			.src_rq		= source,
+			.idle		= CPU_IDLE,
+			/* Keep the destination fixed, as in active balance. */
+			.flags		= LBF_DST_PINNED,
+		};
+
+		list_for_each_entry_reverse(task, &source->cfs_tasks,
+					    se.group_node) {
+			if (scanned++ >= sched_nr_migrate_break)
+				break;
+			if (!can_migrate_task(task, &env))
+				continue;
+			detach_task(task, &env);
+			schedstat_inc(sd->lb_gained[CPU_IDLE]);
+			p = task;
+			break;
+		}
+	}
+out_unlock:
+	/* Release the source before locking the destination, with IRQs off. */
+	rq_unlock(source, &rf);
+	if (p) {
+		attach_one_task(target, p);
+		this_cpu_inc(sched_affinity_pull_moved);
+	}
+	local_irq_restore(rf.flags);
+out_rcu:
+	rcu_read_unlock();
+}
+
+/* An available CPU may prepare work for one remote idle destination. */
+#define AFFINITY_PUSH_SCAN_LIMIT 32
+static DEFINE_PER_CPU(unsigned long, affinity_push_claimed);
+
+void __cold sched_affinity_push_idle(void)
+{
+	struct rq *actor = this_rq();
+	struct rq *source = NULL, *target;
+	struct task_struct *p = NULL, *task;
+	struct sched_domain *sd;
+	struct rq_flags rf;
+	unsigned int busiest = 1, scanned = 0;
+	int cpu, dst = -1, actor_cpu = smp_processor_id();
+
+	if (!cpu_active(actor_cpu))
+		return;
+	this_cpu_inc(sched_affinity_push_attempts);
+	rcu_read_lock();
+	sd = rcu_dereference(actor->sd);
+	while (sd && !(sd->flags & SD_LOAD_BALANCE))
+		sd = sd->parent;
+	if (!sd)
+		goto out_rcu;
+
+	/* Bound both CPU scans; do not expand into a remote domain. */
+	for_each_cpu_and(cpu, sched_domain_span(sd), cpu_active_mask) {
+		if (scanned++ >= AFFINITY_PUSH_SCAN_LIMIT)
+			break;
+		if (cpu == actor_cpu || !idle_cpu(cpu))
+			continue;
+		if (test_and_set_bit_lock(0,
+					 &per_cpu(affinity_push_claimed, cpu)))
+			continue;
+		if (!idle_cpu(cpu)) {
+			clear_bit_unlock(0,
+					 &per_cpu(affinity_push_claimed, cpu));
+			continue;
+		}
+		dst = cpu;
+		break;
+	}
+	if (dst < 0)
+		goto out_rcu;
+	target = cpu_rq(dst);
+	scanned = 0;
+	for_each_cpu_and(cpu, sched_domain_span(sd), cpu_active_mask) {
+		struct rq *rq = cpu_rq(cpu);
+		unsigned int running;
+
+		if (scanned++ >= AFFINITY_PUSH_SCAN_LIMIT)
+			break;
+		if (cpu == dst)
+			continue;
+		running = READ_ONCE(rq->cfs.h_nr_running);
+		if (running > busiest) {
+			busiest = running;
+			source = rq;
+		}
+	}
+	if (!source)
+		goto out_rcu;
+
+	rq_lock_irqsave(source, &rf);
+	if (!cpu_active(cpu_of(source)) || !cpu_active(dst) ||
+	    !idle_cpu(dst) || source->cfs.h_nr_running <= 1)
+		goto out_unlock;
+	update_rq_clock(source);
+	{
+		struct lb_env env = {
+			.sd		= sd,
+			.dst_cpu	= dst,
+			.dst_rq		= target,
+			.src_cpu	= cpu_of(source),
+			.src_rq		= source,
+			.idle		= CPU_IDLE,
+			.flags		= LBF_DST_PINNED,
+		};
+
+		scanned = 0;
+		list_for_each_entry_reverse(task, &source->cfs_tasks,
+					    se.group_node) {
+			if (scanned++ >= sched_nr_migrate_break)
+				break;
+			if (!can_migrate_task(task, &env))
+				continue;
+			detach_task(task, &env);
+			p = task;
+			break;
+		}
+	}
+out_unlock:
+	/* Existing attach logic handles preemption and remote wakeup. */
+	rq_unlock(source, &rf);
+	if (p) {
+		attach_one_task(target, p);
+		this_cpu_inc(sched_affinity_push_moved);
+	}
+	local_irq_restore(rf.flags);
+out_rcu:
+	if (dst >= 0)
+		clear_bit_unlock(0, &per_cpu(affinity_push_claimed, dst));
+	rcu_read_unlock();
+}
+
+#endif
